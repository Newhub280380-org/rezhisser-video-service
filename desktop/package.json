{
  "name": "rezhisser-desktop",
  "productName": "Rezhisser",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app (Electron) for Rezhisser: Owl Browser task dashboard, studio and run history. Opens the cloud service or runs the bundled server locally.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.rezhisser.desktop",
    "productName": "Rezhisser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "server/src"
      },
      {
        "from": "../public",
        "to": "server/public"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
