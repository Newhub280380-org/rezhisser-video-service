# Rezhisser — production environment template.
# Copy to .env for local runs (`node --env-file=.env src/server.js`) or paste
# the values into Railway → Service → Variables. Never commit real secrets.

# --- Core -----------------------------------------------------------------
NODE_ENV=production
# Railway sets PORT automatically.
PORT=3000
# Public origin of the service, no trailing slash. Required for password-reset
# emails and secure cookies, e.g. https://rezhisser.up.railway.app
PUBLIC_ORIGIN=
# Other sites allowed to call the public demo API (comma separated).
ALLOWED_ORIGINS=https://business-41.pazi.dev
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
IMAGE_MAX_BYTES=262144

# --- PostgreSQL -----------------------------------------------------------
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# disable | require | no-verify (empty = driver default; Railway internal network needs none)
DATABASE_SSL=
# Apply schema + library on startup (also done by `npm run db:migrate`).
DB_AUTO_MIGRATE=true

# --- Accounts (JWT) -------------------------------------------------------
# >= 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# --- Video generation: ByteDance (Bitdance) Seedance 2.5 via ModelArk ------
SEEDANCE_API_KEY=
# Model / endpoint id from the ModelArk console (e.g. the Seedance 2.5 model id or ep-xxxx endpoint).
SEEDANCE_MODEL=
# BytePlus (international): https://ark.ap-southeast.bytepluses.com/api/v3
# Volcengine (China):       https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_RESOLUTION=720p
SEEDANCE_GENERATE_AUDIO=true
# How the uploaded photo is used: first_frame | reference_image
SEEDANCE_IMAGE_ROLE=first_frame
# Optional fixed request fields (JSON object, cannot override model/content), e.g. {"watermark":false}
SEEDANCE_EXTRA_INPUT_JSON=
SEEDANCE_POLL_INTERVAL_MS=5000
SEEDANCE_MAX_WAIT_MS=900000
SEEDANCE_REQUEST_TIMEOUT_MS=30000
SEEDANCE_MAX_CONCURRENT=4

# --- Video storage: Backblaze B2 / AWS S3 / MinIO (S3 API) -----------------
# Backblaze B2 example: https://s3.us-west-004.backblazeb2.com with region us-west-004
S3_ENDPOINT=
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Videos are deleted by the cleanup cron after this many days.
VIDEO_RETENTION_DAYS=30
# Lifetime of signed playback/download links.
VIDEO_URL_TTL_SECONDS=3600

# --- Payments: YooKassa (primary, RU/KZ) ----------------------------------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CURRENCIES=RUB,KZT
# Webhook URL to register in YooKassa: ${PUBLIC_ORIGIN}/api/payment/webhook/yookassa
# Events: payment.succeeded, payment.canceled, refund.succeeded

# --- Payments: Stripe (fallback, global cards) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,CNY,KZT,RUB
# Webhook URL: ${PUBLIC_ORIGIN}/api/payment/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired, charge.refunded

# --- Plans ----------------------------------------------------------------
PRO_VIDEOS_PER_PERIOD=50
# Empty = unlimited Studio tier.
STUDIO_VIDEOS_PER_PERIOD=
# Optional price overrides in minor units, e.g. {"pro":{"RUB":49900},"studio":{"KZT":990000}}
PRICES_JSON=

# --- Email (password reset) via Resend ------------------------------------
RESEND_API_KEY=
MAIL_FROM=Rezhisser <no-reply@example.com>

# --- Legacy demo / private beta (Replicate) — optional --------------------
DATA_DIR=./data
VIDEO_PROVIDER=local-simulation
DIRECTOR_ADVISOR=none
PAID_GENERATION_ENABLED=false
BETA_ACCESS_KEY=
PAID_DAILY_BUDGET_USD=0
PAID_DAILY_JOB_LIMIT=3
PAID_TOTAL_JOB_LIMIT=20
REPLICATE_API_TOKEN=
VIDEO_MODEL_PROFILES_JSON=
